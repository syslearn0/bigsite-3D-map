# Xserver（sokubai3d.textetc.net）用。scripts/deploy-xserver.sh が out/.htaccess として置く
RewriteEngine On
# https にそろえる（電波なしで動くための Service Worker は https でないと動かない）
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # 名前に中身の印がついたファイルは、ずっと持ってよい
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # 画面と Service Worker は、毎回新しい版を確かめる
  <FilesMatch "(\.html|sw\.js|\.webmanifest|\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 受け口の共通部分は直接開かせない
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>
# 公開データ（作者が「公開」で書き出す）は毎回新しい版を確かめる
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
